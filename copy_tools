def check_status():
    url = input(f"  {WHITE}URL: {RESET}").strip()
    if not url.startswith(('http://', 'https://')):
        url = 'https://' + url
    
    print(f"\n  {GREEN}⏳ checking...{RESET}")
    try:
        res = requests.get(url, headers={'User-Agent': 'Mozilla/5.0'}, timeout=10)
        print(f"\n{CYAN}  ════════════════════════════════════════════{RESET}")
        print(f"  {BLUE}📡 HTTP STATUS{RESET}")
        print(f"{CYAN}  ════════════════════════════════════════════{RESET}")
        print(f"  {WHITE}URL    : {CYAN}{url}{RESET}")
        print(f"  {WHITE}Status : {GREEN if res.status_code == 200 else YELLOW}{res.status_code} {res.reason}{RESET}")
        print(f"  {WHITE}Size   : {CYAN}{len(res.text):,} bytes{RESET}")
        print(f"  {WHITE}Time   : {CYAN}{res.elapsed.total_seconds():.2f}s{RESET}")
        if res.status_code == 200:
            print(f"  {GREEN}✅ ONLINE{RESET}")
        elif res.status_code in [301, 302]:
            print(f"  {YELLOW}🔄 REDIRECT{RESET}")
        elif res.status_code >= 500:
            print(f"  {RED}❌ SERVER ERROR{RESET}")
        else:
            print(f"  {YELLOW}ℹ️ {res.status_code}{RESET}")
    except Exception as e:
        print(f"  {RED}❌ Gagal: {e}{RESET}")
    print(f"\n{YELLOW}  Enter untuk kembali...{RESET}")
    input()

def get_metadata():
    url = input(f"  {WHITE}URL: {RESET}").strip()
    if not url.startswith(('http://', 'https://')):
        url = 'https://' + url
    
    print(f"\n  {GREEN}⏳ analyzing...{RESET}")
    try:
        res = requests.get(url, headers={'User-Agent': 'Mozilla/5.0'}, timeout=10)
        html = res.text
        soup = BeautifulSoup(html, 'html.parser')
        
        title = soup.title.string.strip() if soup.title else 'N/A'
        desc = soup.find('meta', attrs={'name': 'description'})
        desc = desc.get('content', 'N/A') if desc else 'N/A'
        
        links = len(soup.find_all('a'))
        images = len(soup.find_all('img'))
        scripts = len(soup.find_all('script'))
        styles = len(soup.find_all('link', rel='stylesheet'))
        
        print(f"\n{CYAN}  ════════════════════════════════════════════{RESET}")
        print(f"  {BLUE}📋 METADATA{RESET}")
        print(f"{CYAN}  ════════════════════════════════════════════{RESET}")
        print(f"  {WHITE}📄 Title  : {CYAN}{title}{RESET}")
        print(f"  {WHITE}📝 Desc   : {CYAN}{desc[:80]}{'...' if len(desc) > 80 else ''}{RESET}")
        print(f"  {WHITE}🔗 Links  : {CYAN}{links}{RESET}")
        print(f"  {WHITE}🖼️ Images : {CYAN}{images}{RESET}")
        print(f"  {WHITE}📜 Scripts: {CYAN}{scripts}{RESET}")
        print(f"  {WHITE}🎨 CSS    : {CYAN}{styles}{RESET}")
        print(f"  {WHITE}📦 Size   : {CYAN}{len(html):,} bytes{RESET}")
    except Exception as e:
        print(f"  {RED}❌ Gagal: {e}{RESET}")
    print(f"\n{YELLOW}  Enter untuk kembali...{RESET}")
    input()

def list_files():
    download_path = get_downloads_path()
    base_dir = os.path.join(download_path, 'BONGKAR_WEB')
    
    if not os.path.exists(base_dir):
        print(f"  {YELLOW}⚠️ Folder BONGKAR_WEB tidak ditemukan{RESET}")
        print(f"\n{YELLOW}  Enter untuk kembali...{RESET}")
        input()
        return
    
    clone_folders = []
    for item in os.listdir(base_dir):
        item_path = os.path.join(base_dir, item)
        if os.path.isdir(item_path) and item.startswith('clone_'):
            clone_folders.append(item)
    
    if not clone_folders:
        print(f"  {YELLOW}⚠️ Belum ada clone{RESET}")
        print(f"\n{YELLOW}  Enter untuk kembali...{RESET}")
        input()
        return
    
    clone_folders.sort()
    
    print(f"\n{CYAN}  ════════════════════════════════════════════{RESET}")
    print(f"  {BLUE}📂 HASIL CLONE ({len(clone_folders)} folder){RESET}")
    print(f"{CYAN}  ════════════════════════════════════════════{RESET}")
    
    total_files = 0
    total_size = 0
    
    for folder in clone_folders:
        folder_path = os.path.join(base_dir, folder)
        file_count = 0
        folder_size = 0
        
        for root, dirs, files in os.walk(folder_path):
            file_count += len(files)
            for f in files:
                path = os.path.join(root, f)
                folder_size += os.path.getsize(path)
        
        total_files += file_count
        total_size += folder_size
        
        print(f"\n  {GREEN}📁 {folder}{RESET} ({file_count} files, {folder_size:,} bytes)")
        
        for sub in ['html', 'css', 'js', 'images', 'api', 'fonts']:
            sub_path = os.path.join(folder_path, sub)
            if os.path.exists(sub_path):
                count = len([f for f in os.listdir(sub_path) if os.path.isfile(os.path.join(sub_path, f))])
                if count > 0:
                    print(f"     {WHITE}📄 {sub}/ → {CYAN}{count} files{RESET}")
    
    print(f"\n{CYAN}  ════════════════════════════════════════════{RESET}")
    print(f"  {WHITE}📦 Total   : {GREEN}{total_files} files{RESET}")
    print(f"  {WHITE}💾 Total   : {GREEN}{total_size:,} bytes{RESET}")
    print(f"  {WHITE}📂 Folder  : {CYAN}{base_dir}{RESET}")
    print(f"{CYAN}  ════════════════════════════════════════════{RESET}")
    
    print(f"\n{YELLOW}  Enter untuk kembali...{RESET}")
    input()

