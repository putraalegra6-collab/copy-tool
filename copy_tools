spinner = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
progress_chars = ['░', '▒', '▓', '█']
anim_running = False

def animate_loading(stop_event, message="Processing"):
    global anim_running
    i = 0
    while not stop_event.is_set():
        sys.stdout.write(f'\r  {CYAN}{spinner[i % len(spinner)]}{RESET} {message}...')
        sys.stdout.flush()
        i += 1
        time.sleep(0.1)
    sys.stdout.write(f'\r  {GREEN}✓{RESET} {message} selesai     \n')
    sys.stdout.flush()

def loading_with_animation(func, message):
    stop_event = threading.Event()
    t = threading.Thread(target=animate_loading, args=(stop_event, message))
    t.daemon = True
    t.start()
    result = func()
    stop_event.set()
    t.join(timeout=0.5)
    return result

def show_progress_bar(current, total, prefix=''):
    if total == 0:
        return
    bar_length = 30
    percent = current / total
    filled = int(bar_length * percent)
    bar = '█' * filled + '░' * (bar_length - filled)
    sys.stdout.write(f'\r  {CYAN}{prefix}{RESET} [{bar}] {current}/{total} ({percent*100:.1f}%)')
    sys.stdout.flush()
    if current == total:
        sys.stdout.write('\n')

