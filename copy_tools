def whois_lookup(domain):
    loading_animation("performing WHOIS lookup", 0.8)
    try:
        domain = re.sub(r'^https?://', '', domain)
        domain = domain.split('/')[0]
        
        import socket
        ip = socket.gethostbyname(domain)
        
        print("\n\033[92m════════════════════════════════════════════\033[0m")
        print("\033[92m🌐 WHOIS LOOKUP\033[0m")
        print("\033[92m════════════════════════════════════════════\033[0m")
        print(f"\n \033[92m🌐 Domain\033[0m : {domain}")
        print(f" \033[92m📡 IP\033[0m     : {ip}")
        try:
            import whois
            w = whois.whois(domain)
            if w.creation_date:
                print(f" \033[92m📅 Created\033[0m: {w.creation_date}")
            if w.expiration_date:
                print(f" \033[92m⏳ Expires\033[0m: {w.expiration_date}")
            if w.registrar:
                print(f" \033[92m🏢 Registrar\033[0m: {w.registrar}")
        except:
            pass
    except Exception as e:
        error(f"WHOIS failed: {e}")

