def get_downloads_path():
    paths = [
        '/storage/emulated/0/Download',
        '/sdcard/Download',
        '/storage/emulated/0/Downloads'
    ]
    for p in paths:
        if os.path.exists(p):
            return p
    return os.path.expanduser('~/downloads')

