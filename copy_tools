def loading_animation(text, duration=0.8):
    chars = ['⣾', '⣽', '⣻', '⢿', '⡿', '⣟', '⣯', '⣷']
    end_time = time.time() + duration
    i = 0
    while time.time() < end_time:
        sys.stdout.write(f'\r {GREEN}[{chars[i % len(chars)]}] {WHITE}{text}{RESET}')
        sys.stdout.flush()
        time.sleep(0.08)
        i += 1
    sys.stdout.write(f'\r {GREEN}[✓] {WHITE}{text}{RESET}\n')

def loading(text):
    print(f" {GREEN}• {WHITE}{text}{RESET}")

