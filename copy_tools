class DeepClone:
    def __init__(self, url, output_dir):
        self.url = url
        self.base_url = ''
        self.output_dir = output_dir
        self.downloaded = set()
        self.api_endpoints = set()
        self.total_files = 0
        self.total_size = 0
        self.assets = {'css': [], 'js': [], 'images': [], 'fonts': []}
        self.headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36'
        }
        
    def create_folders(self):
        # Cuma bikin folder yang ada isinya
        folders = ['css', 'js', 'images', 'api']
        for f in folders:
            os.makedirs(os.path.join(self.output_dir, f), exist_ok=True)
            
    def safe_request(self, url, timeout=30):
        try:
            res = requests.get(url, headers=self.headers, timeout=timeout, verify=False, allow_redirects=True)
            return res if res.status_code == 200 else None
        except:
            return None
    
    def download_file(self, url, folder, filename=None):
        if url in self.downloaded:
            return None
        if url.startswith(('data:', 'blob:', 'javascript:')):
            return None
            
        try:
            if not filename:
                parsed = urlparse(url)
                filename = os.path.basename(parsed.path)
                if not filename or '.' not in filename:
                    ext = ''
                    if 'css' in url.lower():
                        ext = '.css'
                    elif 'js' in url.lower():
                        ext = '.js'
                    elif any(x in url.lower() for x in ['.jpg', '.png', '.gif', '.svg', '.webp', '.ico']):
                        ext = os.path.splitext(parsed.path)[1] or '.png'
                    elif any(x in url.lower() for x in ['.woff', '.ttf', '.otf']):
                        ext = '.woff'
                    else:
                        ext = '.html'
                    filename = hashlib.md5(url.encode()).hexdigest()[:12] + ext
            
            filename = re.sub(r'[<>:"/\\|?*]', '_', filename)
            filepath = os.path.join(folder, filename)
            
            if os.path.exists(filepath):
                self.downloaded.add(url)
                return filepath
                
            res = self.safe_request(url, timeout=20)
            if res:
                with open(filepath, 'wb') as f:
                    f.write(res.content)
                self.downloaded.add(url)
                self.total_files += 1
                self.total_size += len(res.content)
                return filepath
        except:
            pass
        return None
    
    def extract_apis(self, content):
        apis = set()
        patterns = [
            r'fetch\s*\(\s*["\']([^"\']+)["\']',
            r'axios\.[a-z]+\s*\(\s*["\']([^"\']+)["\']',
            r'\.(?:get|post|put|delete|patch)\s*\(\s*["\']([^"\']+)["\']',
            r'\/api\/[a-zA-Z0-9/_-]+',
            r'https?://[^"\']+api[^"\']*',
            r'graphql',
            r'\/v[0-9]+\/',
        ]
        for pattern in patterns:
            found = re.findall(pattern, content, re.IGNORECASE)
            for f in found:
                if f and not f.startswith(('data:', 'blob:', 'javascript:')):
                    if f.startswith(('/', 'api', 'http', './', '../')):
                        apis.add(f)
        return apis
    
    def process_html(self, content):
        soup = BeautifulSoup(content, 'html.parser')
        
        # CSS
        for tag in soup.find_all('link'):
            if tag.get('rel') and 'stylesheet' in tag.get('rel'):
                href = tag.get('href')
                if href and not href.startswith(('data:', '//')):
                    full_url = urljoin(self.base_url, href)
                    full_url = urldefrag(full_url)[0]
                    if full_url:
                        self.assets['css'].append(full_url)
                        local = self.download_file(full_url, os.path.join(self.output_dir, 'css'))
                        if local:
                            tag['href'] = os.path.basename(local)
        
        # JS
        for tag in soup.find_all('script'):
            src = tag.get('src')
            if src and not src.startswith(('data:', '//')):
                full_url = urljoin(self.base_url, src)
                full_url = urldefrag(full_url)[0]
                if full_url:
                    self.assets['js'].append(full_url)
                    local = self.download_file(full_url, os.path.join(self.output_dir, 'js'))
                    if local:
                        tag['src'] = os.path.basename(local)
            elif tag.string:
                js = str(tag.string)
                apis = self.extract_apis(js)
                for api in apis:
                    self.api_endpoints.add(api)
        
        # Images
        for tag in soup.find_all(['img', 'source']):
            src = tag.get('src')
            if src and not src.startswith(('data:', 'blob:', '//')):
                full_url = urljoin(self.base_url, src)
                full_url = urldefrag(full_url)[0]
                if full_url:
                    self.assets['images'].append(full_url)
                    local = self.download_file(full_url, os.path.join(self.output_dir, 'images'))
                    if local:
                        tag['src'] = os.path.basename(local)
        
        # Fonts (kalo ada)
        for tag in soup.find_all('link'):
            href = tag.get('href')
            if href and any(x in href.lower() for x in ['font', '.woff', '.ttf', '.otf', '.eot']):
                if not href.startswith(('data:', '//')):
                    full_url = urljoin(self.base_url, href)
                    full_url = urldefrag(full_url)[0]
                    if full_url:
                        self.assets['fonts'].append(full_url)
                        os.makedirs(os.path.join(self.output_dir, 'fonts'), exist_ok=True)
                        local = self.download_file(full_url, os.path.join(self.output_dir, 'fonts'))
                        if local:
                            tag['href'] = os.path.basename(local)
        
        # Extract API dari HTML
        apis = self.extract_apis(content)
        for api in apis:
            self.api_endpoints.add(api)
        
        return str(soup)
    
    def process_css(self, content, base_url):
        pattern = r'url\s*\(\s*["\']?([^"\')\s]+)["\']?\s*\)'
        matches = re.findall(pattern, content)
        for m in matches:
            if not m.startswith(('data:', 'blob:', '//')):
                full_url = urljoin(base_url, m)
                full_url = urldefrag(full_url)[0]
                if full_url:
                    local = self.download_file(full_url, os.path.join(self.output_dir, 'images'))
                    if local:
                        content = content.replace(m, os.path.basename(local))
        return content
    
    def run(self):
        print(f"\n{CYAN}  ════════════════════════════════════════════{RESET}")
        print(f"  {GREEN}🚀 CLONING...{RESET}")
        print(f"{CYAN}  ════════════════════════════════════════════{RESET}")
        
        self.create_folders()
        
        print(f"  {WHITE}📌 Target  : {CYAN}{self.url}{RESET}")
        print(f"  {WHITE}📁 Output  : {CYAN}{self.output_dir}{RESET}")
        print()
        
        # Download index
        print(f"  {GREEN}⏳ Downloading...{RESET}")
        res = self.safe_request(self.url, timeout=30)
        if not res:
            error("Gagal fetch website")
            return
        
        self.base_url = f"{res.url.rstrip('/')}/"
        content = res.text
        
        # Process HTML
        print(f"  {GREEN}⏳ Processing...{RESET}")
        html_content = self.process_html(content)
        
        # Save index
        with open(os.path.join(self.output_dir, 'index.html'), 'w', encoding='utf-8') as f:
            f.write(html_content)
        success("✅ index.html")
        
        # Process CSS
        if self.assets['css']:
            print(f"  {GREEN}⏳ CSS ({len(self.assets['css'])} files)...{RESET}")
            for css_url in self.assets['css']:
                css_res = self.safe_request(css_url, timeout=15)
                if css_res:
                    processed = self.process_css(css_res.text, css_url)
                    filename = os.path.basename(css_url.split('?')[0]) or hashlib.md5(css_url.encode()).hexdigest()[:12] + '.css'
                    with open(os.path.join(self.output_dir, 'css', filename), 'w', encoding='utf-8') as f:
                        f.write(processed)
        
        # Process JS
        if self.assets['js']:
            print(f"  {GREEN}⏳ JS ({len(self.assets['js'])} files)...{RESET}")
            for js_url in self.assets['js']:
                js_res = self.safe_request(js_url, timeout=15)
                if js_res:
                    filename = os.path.basename(js_url.split('?')[0]) or hashlib.md5(js_url.encode()).hexdigest()[:12] + '.js'
                    with open(os.path.join(self.output_dir, 'js', filename), 'w', encoding='utf-8') as f:
                        f.write(js_res.text)
        
        # Save API
        if self.api_endpoints:
            with open(os.path.join(self.output_dir, 'api', 'endpoints.json'), 'w') as f:
                json.dump(list(self.api_endpoints), f, indent=2)
            success(f"✅ API: {len(self.api_endpoints)} endpoints")
        
        # Hapus folder kosong
        for folder in ['css', 'js', 'images', 'api', 'fonts']:
            folder_path = os.path.join(self.output_dir, folder)
            if os.path.exists(folder_path) and not os.listdir(folder_path):
                os.rmdir(folder_path)
        
        # Summary
        print(f"\n{CYAN}  ════════════════════════════════════════════{RESET}")
        print(f"  {GREEN}📊 HASIL CLONE{RESET}")
        print(f"{CYAN}  ════════════════════════════════════════════{RESET}")
        print(f"  {WHITE}📄 HTML   : {GREEN}1 file{RESET}")
        if self.assets['css']:
            print(f"  {WHITE}🎨 CSS    : {GREEN}{len(self.assets['css'])} files{RESET}")
        if self.assets['js']:
            print(f"  {WHITE}⚡ JS     : {GREEN}{len(self.assets['js'])} files{RESET}")
        if self.assets['images']:
            print(f"  {WHITE}🖼️ Images : {GREEN}{len(self.assets['images'])} files{RESET}")
        if self.assets['fonts']:
            print(f"  {WHITE}🔤 Fonts  : {GREEN}{len(self.assets['fonts'])} files{RESET}")
        if self.api_endpoints:
            print(f"  {WHITE}🔗 API    : {GREEN}{len(self.api_endpoints)} endpoints{RESET}")
        print(f"  {WHITE}📦 Total   : {GREEN}{self.total_files} files{RESET}")
        print(f"  {WHITE}💾 Size    : {GREEN}{self.total_size:,} bytes{RESET}")
        print(f"{CYAN}  ════════════════════════════════════════════{RESET}")
        print(f"\n{GREEN}✅ Selesai! {WHITE}{self.output_dir}{RESET}")

