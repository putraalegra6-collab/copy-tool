def play_song(url, title):
    """Putar lagu pake termux-open (suara pasti keluar)"""
    
    clear()
    
    print(f"\n{CYAN}  ════════════════════════════════════════════{RESET}")
    print(f"  {GREEN}🎵 PUTAR LAGU{RESET}")
    print(f"{CYAN}  ════════════════════════════════════════════{RESET}")
    print(f"  {WHITE}🎶 {title}{RESET}")
    print(f"  {CYAN}⏳ Memutar...{RESET}\n")
    
    # ── Coba pake termux-open (paling ampuh buat suara) ──
    try:
        subprocess.Popen(['termux-open', url])
        print(f"  {GREEN}✅ Lagu diputar via termux-open{RESET}")
        print(f"  {YELLOW}💡 Suara keluar dari HP{RESET}")
        print(f"  {YELLOW}💡 Tutup pemutar manual setelah selesai{RESET}")
        return
    except:
        pass
    
    # ── Fallback: mpv ──
    try:
        process = subprocess.Popen(
            ['mpv', '--no-video', url],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        print(f"  {GREEN}✅ Lagu diputar via mpv{RESET}")
        print(f"  {YELLOW}💡 Tekan Ctrl+C untuk stop{RESET}")
        try:
            process.wait()
        except KeyboardInterrupt:
            process.terminate()
            print(f"\n  {YELLOW}⏹️ Lagu dihentikan{RESET}")
        return
    except:
        pass
    
    # ── Fallback: xdg-open ──
    try:
        subprocess.Popen(['xdg-open', url])
        print(f"  {GREEN}✅ Lagu diputar via xdg-open{RESET}")
        return
    except:
        pass
    
    # ── Gagal semua ──
    print(f"  {RED}❌ Gagal putar lagu. Install mpv:{RESET}")
    print(f"  {YELLOW}   pkg install mpv{RESET}")
    print(f"  {YELLOW}   Atau install termux-api:{RESET}")
