def check_status(url):
    loading_animation("checking HTTP status", 0.5)
    try:
        headers = {'User-Agent': 'Mozilla/5.0 Chrome/120.0.0.0'}
        response = requests.get(url, headers=headers, timeout=10)
        status = response.status_code
        
        print("\n\033[92m════════════════════════════════════════════\033[0m")
        print("\033[92m📡 HTTP STATUS CHECK\033[0m")
        print("\033[92m════════════════════════════════════════════\033[0m")
        print(f"\n \033[92m🔗 URL\033[0m    : {url}")
        print(f" \033[92m📊 Status\033[0m : {status} {response.reason}")
        if status == 200:
            print(" \033[92m✅ Status\033[0m : ONLINE - OK")
        elif status == 404:
            print(" \033[91m❌ Status\033[0m : NOT FOUND - Page doesn't exist")
        elif status in [301, 302]:
            print(" \033[93m🔄 Status\033[0m : REDIRECT - Page moved")
        elif status >= 500:
            print(" \033[91m❌ Status\033[0m : SERVER ERROR")
        else:
            print(f" \033[93mℹ️ Status\033[0m : {status}")
        print(f" \033[92m📦 Size\033[0m   : {len(response.text):,} bytes")
        print(f" \033[92m⏱️  Time\033[0m   : {response.elapsed.total_seconds():.2f}s")
    except Exception as e:
        error(f"Failed: {e}")

