def loading_animation(text, duration=0.8):
    chars = ['⣾', '⣽', '⣻', '⢿', '⡿', '⣟', '⣯', '⣷']
    end_time = time.time() + duration
    i = 0
    while time.time() < end_time:
        sys.stdout.write(f'\r \033[92m[{chars[i % len(chars)]}] {text}\033[0m')
        sys.stdout.flush()
        time.sleep(0.08)
        i += 1
    sys.stdout.write(f'\r \033[92m[✓] {text}\033[0m\n')

