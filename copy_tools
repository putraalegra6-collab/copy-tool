# FEATURE 2: GET METADATA
# ============================================================
def get_metadata(url):
    loading_animation("analyzing page metadata", 0.6)
    headers = {'User-Agent': 'Mozilla/5.0 Chrome/120.0.0.0'}
    response = requests.get(url, headers=headers, timeout=10)
    response.raise_for_status()
    html = response.text

    title = re.search(r'<title>(.*?)</title>', html, re.IGNORECASE)
    title = title.group(1).strip() if title else 'N/A'

    desc = re.search(r'<meta[^>]*name=[\'"]description[\'"][^>]*content=[\'"]([^\'"]+)[\'"]', html, re.IGNORECASE)
    desc = desc.group(1).strip() if desc else 'N/A'

    keywords = re.search(r'<meta[^>]*name=[\'"]keywords[\'"][^>]*content=[\'"]([^\'"]+)[\'"]', html, re.IGNORECASE)
    keywords = keywords.group(1).strip() if keywords else 'N/A'

    links_count = len(re.findall(r'<a[^>]*href=[\'"][^\'"]+[\'"]', html))
    images_count = len(re.findall(r'<img[^>]*src=[\'"][^\'"]+[\'"]', html))
    scripts_count = len(re.findall(r'<script[^>]*src=[\'"][^\'"]+[\'"]', html))
    css_count = len(re.findall(r'<link[^>]*rel=[\'"]stylesheet[\'"][^>]*href=[\'"][^\'"]+[\'"]', html))

    return {
        'url': url,
        'title': title,
        'description': desc,
        'keywords': keywords,
        'links': links_count,
        'images': images_count,
        'scripts': scripts_count,
        'css': css_count,
        'size': len(html)
    }

