def batch_clone(urls, include_css=True):
    results = []
    total = len(urls)
    for i, url in enumerate(urls, 1):
        print()
        loading(f"cloning {i}/{total}: {url}")
        try:
            result = clone_page(url, include_css)
            results.append({'url': url, 'status': '✅', 'file': result['filename']})
        except Exception as e:
            results.append({'url': url, 'status': '❌', 'file': str(e)})

    print(f"\n{GREEN}════════════════════════════════════════════{RESET}")
    print(f"{CYAN}📋 BATCH REPORT{RESET}")
    print(f"{GREEN}════════════════════════════════════════════{RESET}")
    for r in results:
        print(f" {GREEN if r['status'] == '✅' else RED}{r['status']}{RESET} {WHITE}{r['url']}{RESET} → {CYAN}{r['file']}{RESET}")

