    headers = {'User-Agent': 'Mozilla/5.0 Chrome/120.0.0.0'}
    response = requests.get(url, headers=headers, timeout=10)
    response.raise_for_status()
    html = response.text[:2000]

    print("\n\033[96m ════════════════════════════════════════════\033[0m")
    print("\033[96m 📄 PAGE PREVIEW (first 20 lines)\033[0m")
    print("\033[96m ════════════════════════════════════════════\033[0m")
    lines = html.split('\n')[:20]
    for i, line in enumerate(lines, 1):
        clean = line.strip()[:80]
        if clean:
            print(f" {i:2}. {clean}")
    print(f"\n \033[94m📦 total size\033[0m: {len(html):,} bytes (first 2kb shown)")

def batch_clone(urls, include_css=True):
    results = []
    total = len(urls)
    for i, url in enumerate(urls, 1):
        print()
        loading(f"cloning {i}/{total}: {url}")
        try:
            result = clone_page(url, include_css)
            results.append({'url': url, 'status': '✅', 'file': result['filename']})
        except Exception as e:
            results.append({'url': url, 'status': '❌', 'file': str(e)})

    print("\n\033[96m ════════════════════════════════════════════\033[0m")
    print("\033[96m 📋 BATCH REPORT\033[0m")
    print("\033[96m ════════════════════════════════════════════\033[0m")
    for r in results:
        print(f" {r['status']} {r['url']} → {r['file']}")
    return results

