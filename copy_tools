def list_files():
    download_path = get_downloads_path()
    base_dir = os.path.join(download_path, 'BONGKAR_WEB')
    
    if not os.path.exists(base_dir):
        warning("Folder BONGKAR_WEB tidak ditemukan")
        print(f"\n{YELLOW}  Enter untuk kembali...{RESET}")
        input()
        return
    
    clone_folders = []
    for item in os.listdir(base_dir):
        item_path = os.path.join(base_dir, item)
        if os.path.isdir(item_path) and item.startswith('clone_'):
            clone_folders.append(item)
    
    if not clone_folders:
        warning("Belum ada clone")
        print(f"\n{YELLOW}  Enter untuk kembali...{RESET}")
        input()
        return
    
    clone_folders.sort()
    
    print(f"\n{CYAN}  ════════════════════════════════════════════{RESET}")
    print(f"  {BLUE}📂 HASIL CLONE ({len(clone_folders)} folder){RESET}")
    print(f"{CYAN}  ════════════════════════════════════════════{RESET}")
    
    total_files = 0
    total_size = 0
    
    for folder in clone_folders:
        folder_path = os.path.join(base_dir, folder)
        file_count = 0
        folder_size = 0
        
        for root, dirs, files in os.walk(folder_path):
            file_count += len(files)
            for f in files:
                path = os.path.join(root, f)
                folder_size += os.path.getsize(path)
        
        total_files += file_count
        total_size += folder_size
        
        print(f"\n  {GREEN}📁 {folder}{RESET} ({file_count} files, {folder_size:,} bytes)")
        
        for sub in ['html', 'css', 'js', 'images', 'api', 'fonts']:
            sub_path = os.path.join(folder_path, sub)
            if os.path.exists(sub_path):
                count = len([f for f in os.listdir(sub_path) if os.path.isfile(os.path.join(sub_path, f))])
                if count > 0:
                    print(f"     {WHITE}📄 {sub}/ → {CYAN}{count} files{RESET}")
    
    print(f"\n{CYAN}  ════════════════════════════════════════════{RESET}")
    print(f"  {WHITE}📦 Total   : {GREEN}{total_files} files{RESET}")
    print(f"  {WHITE}💾 Total   : {GREEN}{total_size:,} bytes{RESET}")
    print(f"  {WHITE}📂 Folder  : {CYAN}{base_dir}{RESET}")
    print(f"{CYAN}  ════════════════════════════════════════════{RESET}")
    
    print(f"\n{YELLOW}  Enter untuk kembali...{RESET}")
    input()

