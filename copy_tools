# TOOL 1: CLONE PAGE
# ============================================================
def clone_page(url, include_css=True):
    loading_animation("initializing cloner", 0.5)
    loading_animation(f"fetching: {url}", 0.6)
    headers = {'User-Agent': 'Mozilla/5.0 Chrome/120.0.0.0'}
    response = requests.get(url, headers=headers, timeout=15)
    response.raise_for_status()
    html = response.text
    base_url = response.url

    if include_css:
        loading_animation("embedding CSS resources", 0.5)
        css_links = re.findall(r'<link[^>]*href=[\'"]([^\'"]+\.css)[\'"][^>]*>', html, re.IGNORECASE)
        for css_url in css_links[:3]:
            try:
                full_css_url = urljoin(base_url, css_url)
                css_response = requests.get(full_css_url, headers=headers, timeout=5)
                if css_response.status_code == 200:
                    html = html.replace(css_url, 'data:text/css;base64,' + css_response.content[:1000].decode('utf-8'))
            except:
                pass

    title_match = re.search(r'<title>(.*?)</title>', html, re.IGNORECASE)
    title = title_match.group(1).strip() if title_match else 'cloned_page'
    filename = re.sub(r'[^a-zA-Z0-9]', '_', title)[:50] or 'cloned_page'

    download_path = get_downloads_path()
    output_dir = os.path.join(download_path, 'COPY_TOOLS')
    os.makedirs(output_dir, exist_ok=True)

    html_file = os.path.join(output_dir, f'{filename}.html')
    with open(html_file, 'w', encoding='utf-8') as f:
        f.write(html)

    return {
        'success': True,
        'path': html_file,
        'title': title,
        'size': len(html),
        'filename': filename
    }

