# TOOL 8: CHECK SSL CERTIFICATE
# ============================================================
def check_ssl(domain):
    loading_animation("checking SSL certificate", 0.6)
    try:
        domain = re.sub(r'^https?://', '', domain)
        domain = domain.split('/')[0]
        
        context = ssl.create_default_context()
        with socket.create_connection((domain, 443), timeout=5) as sock:
            with context.wrap_socket(sock, server_hostname=domain) as ssock:
                cert = ssock.getpeercert()
                
        print(f"\n{GREEN}════════════════════════════════════════════{RESET}")
        print(f"{CYAN}🔒 SSL CERTIFICATE{RESET}")
        print(f"{GREEN}════════════════════════════════════════════{RESET}")
        print(f"\n {CYAN}🌐 Domain{RESET}    : {WHITE}{domain}{RESET}")
        print(f" {CYAN}📅 Issuer{RESET}    : {WHITE}{cert.get('issuer', 'N/A')}{RESET}")
        print(f" {CYAN}⏳ Expires{RESET}   : {WHITE}{cert.get('notAfter', 'N/A')}{RESET}")
        print(f" {GREEN}✅ Valid{RESET}      : {WHITE}{'Yes' if cert.get('notAfter') else 'No'}{RESET}")
    except Exception as e:
        error(f"SSL check failed: {e}")

