        print(f" {GREEN if r['status'] == '✅' else RED}{r['status']}{RESET} {WHITE}{r['url']}{RESET} → {PURPLE}{r['file']}{RESET}")
    print(f"\n{YELLOW}  press Enter to continue...{RESET}")
    input()

