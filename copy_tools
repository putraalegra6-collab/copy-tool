def check_status(url):
    loading_animation("checking HTTP status", 0.5)
    try:
        headers = {'User-Agent': 'Mozilla/5.0 Chrome/120.0.0.0'}
        response = requests.get(url, headers=headers, timeout=10)
        status = response.status_code
        
        print(f"\n{CYAN}════════════════════════════════════════════{RESET}")
        print(f"{BLUE}📡 HTTP STATUS CHECK{RESET}")
        print(f"{CYAN}════════════════════════════════════════════{RESET}")
        print(f"\n {BLUE}🔗 URL{RESET}    : {WHITE}{url}{RESET}")
        print(f" {BLUE}📊 Status{RESET} : {WHITE}{status} {response.reason}{RESET}")
        if status == 200:
            print(f" {GREEN}✅ Status{RESET} : ONLINE")
        elif status == 404:
            print(f" {RED}❌ Status{RESET} : NOT FOUND")
        elif status in [301, 302]:
            print(f" {YELLOW}🔄 Status{RESET} : REDIRECT")
        elif status >= 500:
            print(f" {RED}❌ Status{RESET} : SERVER ERROR")
        else:
            print(f" {YELLOW}ℹ️ Status{RESET} : {status}")
        print(f" {BLUE}📦 Size{RESET}   : {WHITE}{len(response.text):,} bytes{RESET}")
        print(f" {BLUE}⏱️  Time{RESET}   : {WHITE}{response.elapsed.total_seconds():.2f}s{RESET}")
    except Exception as e:
        error(f"Failed: {e}")
    print(f"\n{YELLOW}  press Enter to continue...{RESET}")
    input()

