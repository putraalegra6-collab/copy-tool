def get_downloads_path():
    paths = [
        '/storage/emulated/0/Download',
        '/sdcard/Download',
        '/storage/emulated/0/Downloads',
        os.path.expanduser('~/Downloads'),
        os.path.expanduser('~/downloads')
    ]
    for p in paths:
        if os.path.exists(p):
            return p
    return os.getcwd()

