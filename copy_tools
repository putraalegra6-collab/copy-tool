def download_images_from_website(url):
    loading_animasi_gerak("scanning for images", 0.8)
    headers = {'User-Agent': 'Mozilla/5.0 Chrome/120.0.0.0'}
    try:
        response = requests.get(url, headers=headers, timeout=8)
        response.raise_for_status()
    except Exception as e:
        error(f"Failed to fetch URL: {e}")
        print(f"\n{YELLOW}  press Enter to continue...{RESET}")
        input()
        return
    
    html = response.text
    base_url = response.url

    img_patterns = [
        r'<img[^>]*src=[\'"]([^\'"]+)[\'"]',
        r'<link[^>]*rel=[\'"]icon[\'"][^>]*href=[\'"]([^\'"]+)[\'"]',
        r'<link[^>]*rel=[\'"]apple-touch-icon[\'"][^>]*href=[\'"]([^\'"]+)[\'"]'
    ]
    
    all_images = []
    for pattern in img_patterns:
        matches = re.findall(pattern, html, re.IGNORECASE)
        for img in matches:
            full_url = urljoin(base_url, img)
            if full_url.startswith(('http://', 'https://')):
                all_images.append(full_url)
    
    unique_images = list(set(all_images))
    
    if not unique_images:
        warning("no images found on this page")
        print(f"\n{YELLOW}  press Enter to continue...{RESET}")
        input()
        return
    
    download_path = get_downloads_path()
    output_dir = os.path.join(download_path, 'BONGKAR_WEB')
    os.makedirs(output_dir, exist_ok=True)
    
    print(f"\n{CYAN}════════════════════════════════════════════{RESET}")
    print(f"{BLUE}📸 DOWNLOADING IMAGES ({len(unique_images)} found){RESET}")
    print(f"{CYAN}════════════════════════════════════════════{RESET}")
    
    downloaded = 0
    total = min(len(unique_images), 20)
    for i, img_url in enumerate(unique_images[:20], 1):
        loading_animasi_gerak(f"downloading image {i}/{total}", 0.5)
        try:
            img_response = requests.get(img_url, headers=headers, timeout=5)
            if img_response.status_code == 200:
                content_type = img_response.headers.get('content-type', '')
                if 'image' in content_type:
                    filename = img_url.split('/')[-1].split('?')[0]
                    if not filename or '.' not in filename:
                        ext = content_type.split('/')[-1]
                        filename = f'image_{i}.{ext}'
                    
                    filepath = os.path.join(output_dir, filename)
                    with open(filepath, 'wb') as f:
                        f.write(img_response.content)
                    downloaded += 1
                    print(f" {GREEN}✅{WHITE} {filename} ({len(img_response.content):,} bytes){RESET}")
                else:
                    print(f" {YELLOW}⚠️{WHITE} {filename} - skipped (not image){RESET}")
            else:
                print(f" {RED}❌{WHITE} failed: {img_url[:40]}... (status {img_response.status_code}){RESET}")
        except Exception as e:
            print(f" {RED}❌{WHITE} error: {img_url[:40]}...{RESET}")
    
    print(f"\n{GREEN}✅ Downloaded {downloaded} images to:{RESET}")
    print(f"{WHITE}  {output_dir}{RESET}")
    print(f"\n{YELLOW}  press Enter to continue...{RESET}")
    input()

