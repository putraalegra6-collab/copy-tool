            results.append({'url': url, 'status': '✅', 'file': result['filename']})
        except Exception as e:
            results.append({'url': url, 'status': '❌', 'file': str(e)})

    print("\n\033[92m════════════════════════════════════════════\033[0m")
    print("\033[92m📋 BATCH REPORT\033[0m")
    print("\033[92m════════════════════════════════════════════\033[0m")
