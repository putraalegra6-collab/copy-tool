def loading_animation(text, duration=0.6):
    chars = ['⣾', '⣽', '⣻', '⢿', '⡿', '⣟', '⣯', '⣷']
    end_time = time.time() + duration
    i = 0
    while time.time() < end_time:
        sys.stdout.write(f'\r {GREEN}[{chars[i % len(chars)]}] {WHITE}{text}{RESET}')
        sys.stdout.flush()
        time.sleep(0.08)
        i += 1
    sys.stdout.write(f'\r {GREEN}[✓] {WHITE}{text}{RESET}\n')

def progress_bar(current, total, text='', emoji='📦'):
    pct = (current / total * 100) if total > 0 else 0
    bar_len = 30
    filled = int(pct / 100 * bar_len)
    bar = '█' * filled + '░' * (bar_len - filled)
    sys.stdout.write(f'\r {CYAN}{emoji} [{bar}] {WHITE}{pct:.1f}% {text}{RESET}')
    sys.stdout.flush()
    if pct >= 100:
        print()

