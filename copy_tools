# TOOL 5: CHECK SSL CERTIFICATE
# ============================================================
def check_ssl(domain):
    loading_animation("checking SSL certificate", 0.6)
    try:
        domain = re.sub(r'^https?://', '', domain)
        domain = domain.split('/')[0]
        
        import ssl
        import socket
        
        context = ssl.create_default_context()
        with socket.create_connection((domain, 443), timeout=5) as sock:
            with context.wrap_socket(sock, server_hostname=domain) as ssock:
                cert = ssock.getpeercert()
                
        print("\n\033[92m════════════════════════════════════════════\033[0m")
        print("\033[92m🔒 SSL CERTIFICATE\033[0m")
        print("\033[92m════════════════════════════════════════════\033[0m")
        print(f"\n \033[92m🌐 Domain\033[0m    : {domain}")
        print(f" \033[92m📅 Issuer\033[0m    : {cert.get('issuer', 'N/A')}")
        print(f" \033[92m⏳ Expires\033[0m   : {cert.get('notAfter', 'N/A')}")
        print(f" \033[92m✅ Valid\033[0m      : {'Yes' if cert.get('notAfter') else 'No'}")
    except Exception as e:
        error(f"SSL check failed: {e}")

